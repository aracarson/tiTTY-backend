# MARK: - Task list
# Copy to /etc/titty-backend/titty-backend.env on EC2.

TITTY_BIND_ADDRESS=127.0.0.1:8080
TITTY_DATABASE_URL=sqlite:///var/lib/titty-backend/identity.db?mode=rwc
TITTY_JWT_SECRET=replace-with-at-least-32-random-bytes
TITTY_JWT_ISSUER=titty-identity
TITTY_SESSION_TTL_SECONDS=3600
TITTY_CHALLENGE_TTL_SECONDS=180
TITTY_MAX_BODY_BYTES=65536
TITTY_ALLOWED_ORIGIN=https://your-client-or-admin-origin.example
RUST_LOG=titty_backend=info,tower_http=info

# S3 backup settings
TITTY_DATABASE_PATH=/var/lib/titty-backend/identity.db
TITTY_BACKUP_DIR=/var/lib/titty-backend/backups
TITTY_BACKUP_S3_URI=s3://replace-bucket/titty-backend
