[Unit]
Description=Back up tiTTY identity SQLite database to S3
After=titty-backend.service

[Service]
Type=oneshot
User=titty-backend
Group=titty-backend
EnvironmentFile=/etc/titty-backend/titty-backend.env
ExecStart=/opt/titty-backend/bin/backup-to-s3.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/titty-backend
