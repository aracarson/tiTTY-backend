## Or inspect the raw JSONL version:
Get-Content .\reports\api-metrics\graphql-request-bodies.jsonl

## Verify the detailed report preserved source-IP diversity:
jq -r '.source_ip' .\reports\api-metrics\graphql-request-bodies.jsonl | \
  Sort-Object | Get-Unique

## On EC2, compare the generated body report with the raw access events:
sudo jq -r '.source_ip // .fields.source_ip' \
  /var/lib/titty-backend/api-metrics/*/graphql-request-bodies.jsonl | \
  sort | uniq -c | sort -nr

## Open the private source map report locally. Do not double-click the HTML
## from a file:// URL: OpenStreetMap requires an HTTP Referer for tile usage.
## Download the report directory from S3 first, replacing REPORT_TIMESTAMP:

aws s3 cp `
  s3://identitty/reports/api/REPORT_TIMESTAMP/ `
  .\api-report `
  --recursive `
  --region ca-central-1

## From the directory containing .\api-report, start a local web server:
python -m http.server 8000 --directory .\api-report

## Then open this URL in your browser:
http://127.0.0.1:8000/api-source-map.html

## Copy HTML files from the newest API report folder into .\reports
## The generator uploads to s3://identitty/reports/api/<timestamp>/.

$latestApiReport = aws s3api list-objects-v2 `
  --bucket identitty `
  --prefix reports/api/ `
  --delimiter / `
  --query 'CommonPrefixes[].Prefix' `
  --output text | `
  ForEach-Object { $_ -split '\s+' } | `
  Where-Object { $_ -match '^reports/api/\d{8}T\d{6}Z/$' } | `
  Sort-Object | `
  Select-Object -Last 1

if (-not $latestApiReport) {
  throw 'No timestamped API report folder was found in s3://identitty/reports/api/'
}

New-Item -ItemType Directory -Force .\reports | Out-Null
aws s3 cp `
  "s3://identitty/$latestApiReport" `
  .\reports\api-metrics `
  --recursive `
  --exclude '*' `
  --include '*.html' `
  --region ca-central-1

Write-Host "Copied HTML files from s3://identitty/$latestApiReport to .\reports"

