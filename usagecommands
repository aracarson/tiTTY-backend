## Verify body logging is actually configured before generating a report.
## The setting must be in the exact EnvironmentFile used by systemd:
sudo grep -n '^TITTY_LOG_GRAPHQL_BODY=' /etc/titty-backend/titty-backend.env

## If the command above prints nothing, add the setting as root:
echo 'TITTY_LOG_GRAPHQL_BODY=true' | sudo tee -a /etc/titty-backend/titty-backend.env
sudo chmod 0640 /etc/titty-backend/titty-backend.env
sudo chown root:titty-backend /etc/titty-backend/titty-backend.env

## Reload the unit and restart the backend. Editing the file alone does not
## change the environment of an already-running process:
sudo systemctl daemon-reload
sudo systemctl restart titty-backend.service
sudo systemctl is-active titty-backend.service

## Confirm the running backend process loaded the setting. The Environment
## property is not reliable for values supplied through EnvironmentFile on
## all systemd versions:
pid=$(sudo systemctl show titty-backend.service --property=MainPID --value)
sudo cat "/proc/${pid}/environ" | tr '\0' '\n' | \
  grep '^TITTY_LOG_GRAPHQL_BODY='

## Make a GraphQL request, then check the raw event on the EC2 host:
sudo grep -R 'graphql_request_body' /var/log/titty-backend/api-access.jsonl*

## From Bash, test the public endpoint with the JSON content type:
curl -sS -X POST 'https://iden.titty.app/graphql' \
  -H 'Content-Type: application/json' \
  --data '{"query":"{ __typename }"}'

## From Windows PowerShell, use double quotes around the JSON body:
curl.exe -sS -X POST 'https://iden.titty.app/graphql' `
  -H 'Content-Type: application/json' `
  --data '{"query":"{ __typename }"}'

## From Windows cmd.exe, escape the JSON quotes:
curl.exe -sS -X POST https://iden.titty.app/graphql ^
  -H "Content-Type: application/json" ^
  --data "{\"query\":\"{ __typename }\"}"

