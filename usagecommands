### TO build a new binary version:
## git pull the repo for updates
## on macos with docker buildx you can build a linux arm64 binary with the following command:

docker buildx build \
  --platform linux/arm64 \
  -t titty-backend:latest \
  --load \
  .

#then run the following command to extract the binary from the docker image:
container=$(docker create titty-backend:latest)

#then run the following command to copy the binary from the container to your local machine:
docker cp \
  "$container:/usr/local/bin/titty-backend" \
  ./titty-backend-linux-arm64
# cleanup the container
docker rm "$container"


## upload it to S3
aws s3 cp \
  ./titty-backend-linux-arm64 \
  s3://identitty/titty-backend-linux-arm64 \
  --region ca-central-1

## generate presigned URL
aws s3 presign \
  s3://identitty/titty-backend-linux-arm64 \
  --expires-in 3600 \
  --region ca-central-1


