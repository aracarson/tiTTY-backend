{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteIdentityBackups",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::REPLACE_BUCKET/REPLACE_PREFIX/*"
    },
    {
      "Sid": "ListIdentityBackupPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::REPLACE_BUCKET",
      "Condition": {
        "StringLike": {
          "s3:prefix": "REPLACE_PREFIX/*"
        }
      }
    }
  ]
}
